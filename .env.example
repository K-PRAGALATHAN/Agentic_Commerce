# ============================================================
# Agentic Commerce — environment (TEST ONLY). Copy to .env
# ============================================================

# --- Razorpay (TEST keys only: rzp_test_...) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Model (agent service) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Data ---
DATABASE_URL=postgres://agentic:agentic@postgres:5432/agentic
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-in-local-dev
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=7200      # 2 hours of active use
JWT_REFRESH_TTL=2592000  # 30 days; renews the above silently


# --- Optional: web search for product-description autofill ---
# Leave blank and drafting still works, grounded in your own catalogue.
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# --- Agent memory ---
MEM0_API_KEY=

# --- Server ---
BACKEND_PORT=4000
AGENT_PORT=8010
NODE_ENV=development
