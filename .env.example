# ============================================================
# Agentic Commerce — environment (TEST ONLY). Copy to .env
# ============================================================

# --- Razorpay (TEST keys only: rzp_test_...) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Model (agent service) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Data ---
DATABASE_URL=postgres://agentic:agentic@postgres:5432/agentic
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-in-local-dev
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Catalog source (Door 1: internet fetch/seed) ---
CATALOG_SOURCE_URL=https://dummyjson.com/products?limit=30

# --- Agent memory ---
MEM0_API_KEY=

# --- Server ---
BACKEND_PORT=4000
AGENT_PORT=8000
NODE_ENV=development
